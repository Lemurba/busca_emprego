; Exemplo para o supervisor que já existe no container Hermes.
; Não cria outro container e não substitui o processo principal do Hermes.
[program:busca-emprego-radar]
; radar-s6-run.sh carrega as chaves permitidas de .env.local (tokens, porta, bind) antes de iniciar.
command=/opt/data/dashboard/busca_emprego/ops/hermes/radar-s6-run.sh
directory=/opt/data/dashboard/busca_emprego
autostart=true
autorestart=unexpected
startsecs=5
startretries=3
stopsignal=TERM
stopasgroup=true
killasgroup=true
stdout_logfile=/dev/fd/1
stdout_logfile_maxbytes=0
stderr_logfile=/dev/fd/2
stderr_logfile_maxbytes=0
; PORT, RADAR_TRUST_PROXY_TLS e os tokens vêm só de .env.local (fonte única).
environment=NODE_ENV="production",RADAR_APP_DIR="/opt/data/dashboard/busca_emprego"
