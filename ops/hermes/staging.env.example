# Non-secret staging configuration. Secret values are injected by Hermes.
RADAR_ENVIRONMENT=staging
RADAR_OPERATOR_ID=replace-with-on-call-operator
RADAR_APP_DIR=/opt/hermes/plugins/busca-emprego-staging
RADAR_DB_PATH=/var/lib/hermes/busca-emprego-staging/radar.sqlite
RADAR_BACKUP_DIR=/var/backups/hermes/busca-emprego-staging
RADAR_HEALTH_URL=http://127.0.0.1:18787/api/health
PORT=18787
RADAR_TRUST_PROXY_TLS=true
RADAR_AUTH_RATE_LIMIT_MAX=120
RADAR_AUTH_RATE_LIMIT_WINDOW_MS=60000

# Secret-store bindings (names/references only; never put values in this file):
# RADAR_AUTH_CREDENTIALS -> hermes://busca-emprego/staging/api-credentials
# HERMES_SECRET_RUNTIME_SERVICE_TOKEN -> hermes://busca-emprego/staging/runtime-service-token
# Telegram bot/recipient and source credentials remain inside Hermes capabilities/profiles.
