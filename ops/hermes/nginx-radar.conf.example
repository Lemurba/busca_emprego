# Include inside the existing Hermes TLS virtual host. Certificates remain
# managed by the platform proxy; the Node process is never internet-facing.
#
# O link de sessão é /auth?token=<RADAR_DASHBOARD_TOKEN>: a query string de /auth
# não pode ir para o log. Defina no contexto `http {}` (log_format não vale dentro
# de server/location) um formato que usa $uri, nunca $request, $request_uri nem $args:
#
#   log_format radar_sem_query '$remote_addr - [$time_local] "$request_method $uri" '
#                              '$status $body_bytes_sent "$http_user_agent"';
#
# O Radar limita falhas de /auth por IP; ele só confia no X-Forwarded-For vindo
# deste proxy em loopback (RADAR_TRUST_PROXY_TLS=true) e usa a entrada mais à
# direita, a que $proxy_add_x_forwarded_for acrescenta.
location = /plugins/busca-emprego/auth {
    access_log /var/log/nginx/radar-auth.log radar_sem_query;
    proxy_pass http://127.0.0.1:8787/auth$is_args$args;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Request-Id $request_id;
    proxy_hide_header X-Powered-By;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
}

location /plugins/busca-emprego/ {
    proxy_pass http://127.0.0.1:8787/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Request-Id $request_id;
    proxy_hide_header X-Powered-By;
    client_max_body_size 8m;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
}
