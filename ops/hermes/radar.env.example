# Exemplo ÚNICO do .env.local do Radar de Vagas (contratos C3/C4).
#
#   cp ops/hermes/radar.env.example .env.local && chmod 600 .env.local
#
# .env.local fica na raiz do repositório instalado (padrão /opt/data/dashboard/busca_emprego),
# é ignorado pelo Git e nunca é copiado para outro lugar. Valores secretos ficam vazios aqui:
# gere-os na máquina, por exemplo com
#   node -e 'console.log(require("node:crypto").randomBytes(32).toString("hex"))'
# ops/hermes/radar-s6-run.sh exporta ao processo só as chaves da sua allowlist (as deste
# arquivo e alguns ajustes opcionais documentados lá); o resto do arquivo é ignorado.

# --- Processo HTTP ---------------------------------------------------------------------
RADAR_ENVIRONMENT=production
# Porta canônica 8787. Uma instalação pode trocar aqui; nenhum script tem outro padrão.
PORT=8787
# Interface de escuta. 127.0.0.1 = só o próprio container (recomendado; acesso externo via
# proxy TLS). Use o IP da LAN apenas se o firewall restringir a porta à rede doméstica.
RADAR_BIND_HOST=127.0.0.1
# Hosts aceitos no header Host (separados por vírgula). Padrão: 127.0.0.1,localhost (+ porta).
# Acrescente o nome/IP pelo qual o dashboard é aberto, ex.: radar.local,192.0.2.10
RADAR_ALLOWED_HOSTS=127.0.0.1,localhost
# URL pela qual o dashboard é aberto, usada por scripts/ops/dashboard-link.mjs no link de acesso
# (ex.: http://192.0.2.10:8787 ou https://radar.local). Vazio = http://RADAR_BIND_HOST:PORT.
RADAR_PUBLIC_URL=
# true somente atrás de proxy TLS em loopback (x-forwarded-proto só é confiado nesse caso).
RADAR_TRUST_PROXY_TLS=false

# --- Autenticação (C3) -----------------------------------------------------------------
# Obrigatório. Header x-radar-service-token dos agentes/scripts. Sem ele as rotas internas
# respondem 503 internal_token_not_configured. 32 bytes aleatórios; nunca imprima.
RADAR_INTERNAL_SERVICE_TOKEN=
# Obrigatório para abrir o dashboard. Trocado por cookie de sessão em GET /auth?token=...;
# gere o link com: node scripts/ops/dashboard-link.mjs  (--send manda pelo Telegram do Hermes)
RADAR_DASHBOARD_TOKEN=
# Validade da sessão do dashboard em dias (padrão 30). Reiniciar o serviço encerra as sessões.
RADAR_SESSION_TTL_DAYS=30

# --- Operação --------------------------------------------------------------------------
# Identifica a pessoa responsável pela instalação (auditoria). Obrigatório.
RADAR_OPERATOR_ID=
# Banco SQLite em volume persistente (/opt/data). Uma única instância HTTP por arquivo.
RADAR_DB_PATH=/opt/data/dashboard/busca_emprego/data/radar.sqlite
RADAR_BACKUP_DIR=/opt/data/backups/radar-vagas
# Logs do serviço s6 (fora do repositório).
RADAR_LOG_DIR=/opt/data/logs
# Gate da candidatura automatizada. Ligue só com executor testado (test/executor.test.mjs).
RADAR_AUTO_APPLICATION_ENABLED=false

# --- Telegram (gateway do Hermes) ------------------------------------------------------
# Nomes oficiais do Hermes. Deixe vazio para herdar de ~/.hermes/.env (/opt/data/.env),
# onde o setup do Telegram do Hermes já os grava. O bot token NUNCA vai neste arquivo.
TELEGRAM_ALLOWED_USERS=
TELEGRAM_HOME_CHANNEL=

# --- Navegador (opcional) --------------------------------------------------------------
# URL do visualizador remoto da sessão do navegador (ex.: noVNC), se houver. Só exibida ao
# operador; o Hermes se conecta pelo browser.cdp_url do config.yaml.
RADAR_BROWSER_VIEWER_URL=
