# Non-secret configuration for the single Busca Emprego installation.
RADAR_ENVIRONMENT=production
RADAR_OPERATOR_ID=replace-with-responsible-operator
RADAR_APP_DIR=/opt/hermes/plugins/busca-emprego
RADAR_DB_PATH=/var/lib/hermes/busca-emprego/radar.sqlite
RADAR_BACKUP_DIR=/var/backups/hermes/busca-emprego
RADAR_HEALTH_URL=http://127.0.0.1:8787/api/health
PORT=8787
RADAR_TRUST_PROXY_TLS=false

# Secret-store bindings (names/references only; never put values in this file):
# HERMES_SECRET_RUNTIME_SERVICE_TOKEN -> hermes://busca-emprego/runtime-service-token
# Telegram is inherited from the capability already linked to Hermes; no bot or recipient setting exists here.
