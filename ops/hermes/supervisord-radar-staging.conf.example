[program:busca-emprego-radar-staging]
command=/opt/hermes/plugins/busca-emprego-staging/ops/hermes/radar-process.sh
directory=/opt/hermes/plugins/busca-emprego-staging
autostart=true
autorestart=unexpected
startsecs=5
startretries=3
stopsignal=TERM
stopasgroup=true
killasgroup=true
stdout_logfile=/dev/fd/1
stdout_logfile_maxbytes=0
stderr_logfile=/dev/fd/2
stderr_logfile_maxbytes=0
environment=NODE_ENV="production",RADAR_ENVIRONMENT="staging",RADAR_OPERATOR_ID="%(ENV_RADAR_OPERATOR_ID)s",PORT="18787",RADAR_APP_DIR="/opt/hermes/plugins/busca-emprego-staging",RADAR_DB_PATH="/var/lib/hermes/busca-emprego-staging/radar.sqlite",RADAR_TRUST_PROXY_TLS="true"
