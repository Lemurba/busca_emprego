{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "src/**",
      "public/**/*.ts",
      "public/**/*.tsx",
      "public/**/*.js",
      "scripts/**",
      "test/**",
      "hermes/**/*.mjs",
      "hermes/**/*.js",
      "!!**/dist"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "useIterableCallbackReturn": "warn",
        "noAssignInExpressions": "warn"
      },
      "correctness": {
        "noInnerDeclarations": "warn",
        "usePlaywrightValidDescribeCallback": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "test/ui/**"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "usePlaywrightValidDescribeCallback": "error"
          }
        }
      }
    }
  ]
}
