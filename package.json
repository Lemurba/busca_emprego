{
  "name": "radar-vagas-hermes-dashboard",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs && esbuild public/app.ts --bundle --minify --outfile=dist/public/app.js",
    "test": "node --import tsx --test --experimental-test-coverage --test-coverage-include=\"src/**\" \"test/*.test.mjs\" && npm run test:py",
    "test:unit": "node --import tsx --test \"test/*.test.mjs\"",
    "test:e2e": "npm run build && node --test \"test/e2e/*.test.mjs\"",
    "test:py": "python3 -m unittest discover -s hermes/native-plugin",
    "test:all": "npm test && npm run test:e2e",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.public.json",
    "start": "node dist/src/server.js",
    "dev": "npm run build && node dist/src/server.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24.3.0",
    "esbuild": "^0.25.9",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "docx": "^9.7.1",
    "leaflet": "1.9.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.3.289",
    "zod": "^4.6.5"
  }
}
