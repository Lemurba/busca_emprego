{
  "mcpServers": {
    "radar-vagas-coordenador": {
      "command": "node",
      "args": [
        "${env:RADAR_APP_DIR}/dist/src/mcp-server.js"
      ],
      "env": {
        "RADAR_API_URL": "${env:RADAR_API_URL}",
        "RADAR_INTERNAL_SERVICE_TOKEN": "${env:RADAR_INTERNAL_SERVICE_TOKEN}",
        "RADAR_FORWARDED_PROTO": "${env:RADAR_FORWARDED_PROTO}",
        "RADAR_ENVIRONMENT": "production",
        "RADAR_MCP_ROLE": "coordenador",
        "RADAR_MCP_AGENT_ID": "${env:RADAR_COORDINATOR_AGENT_ID}"
      }
    },
    "radar-vagas-coleta": {
      "command": "node",
      "args": [
        "${env:RADAR_APP_DIR}/dist/src/mcp-server.js"
      ],
      "env": {
        "RADAR_API_URL": "${env:RADAR_API_URL}",
        "RADAR_INTERNAL_SERVICE_TOKEN": "${env:RADAR_INTERNAL_SERVICE_TOKEN}",
        "RADAR_FORWARDED_PROTO": "${env:RADAR_FORWARDED_PROTO}",
        "RADAR_ENVIRONMENT": "production",
        "RADAR_MCP_ROLE": "coleta"
      }
    },
    "radar-vagas-curriculo": {
      "command": "node",
      "args": [
        "${env:RADAR_APP_DIR}/dist/src/mcp-server.js"
      ],
      "env": {
        "RADAR_API_URL": "${env:RADAR_API_URL}",
        "RADAR_INTERNAL_SERVICE_TOKEN": "${env:RADAR_INTERNAL_SERVICE_TOKEN}",
        "RADAR_FORWARDED_PROTO": "${env:RADAR_FORWARDED_PROTO}",
        "RADAR_ENVIRONMENT": "production",
        "RADAR_MCP_ROLE": "curriculo"
      }
    },
    "radar-vagas-preferencias": {
      "command": "node",
      "args": [
        "${env:RADAR_APP_DIR}/dist/src/mcp-server.js"
      ],
      "env": {
        "RADAR_API_URL": "${env:RADAR_API_URL}",
        "RADAR_INTERNAL_SERVICE_TOKEN": "${env:RADAR_INTERNAL_SERVICE_TOKEN}",
        "RADAR_FORWARDED_PROTO": "${env:RADAR_FORWARDED_PROTO}",
        "RADAR_ENVIRONMENT": "production",
        "RADAR_MCP_ROLE": "preferencias"
      }
    },
    "radar-vagas-executor": {
      "command": "node",
      "args": [
        "${env:RADAR_APP_DIR}/dist/src/mcp-server.js"
      ],
      "env": {
        "RADAR_API_URL": "${env:RADAR_API_URL}",
        "RADAR_INTERNAL_SERVICE_TOKEN": "${env:RADAR_INTERNAL_SERVICE_TOKEN}",
        "RADAR_FORWARDED_PROTO": "${env:RADAR_FORWARDED_PROTO}",
        "RADAR_ENVIRONMENT": "production",
        "RADAR_MCP_ROLE": "executor",
        "RADAR_MCP_AGENT_ID": "${env:RADAR_EXECUTOR_AGENT_ID}",
        "RADAR_AUTHORIZATION_SECRET": "${env:RADAR_AUTHORIZATION_SECRET}",
        "TELEGRAM_ALLOWED_USERS": "${env:TELEGRAM_ALLOWED_USERS}",
        "TELEGRAM_HOME_CHANNEL": "${env:TELEGRAM_HOME_CHANNEL}",
        "RADAR_AUTO_APPLICATION_ENABLED": "${env:RADAR_AUTO_APPLICATION_ENABLED}"
      }
    }
  }
}
