{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://busca-emprego.local/schemas/onboarding.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "locale", "guide", "installation", "telegramIntegration", "secretPolicy", "phases", "sourceAuthFlows", "prompts", "readiness"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "locale": { "const": "pt-BR" },
    "guide": { "const": "ONBOARDING.md" },
    "installation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "selectableEnvironment", "singleApplication", "authentication", "networkScope", "listenAddress", "port"],
      "properties": {
        "mode": { "const": "production" },
        "selectableEnvironment": { "const": false },
        "singleApplication": { "const": true },
        "authentication": { "const": "none" },
        "networkScope": { "const": "private-lan" },
        "listenAddress": { "const": "0.0.0.0" },
        "port": { "const": 8787 }
      }
    },
    "telegramIntegration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "configurationRequired", "requestBotToken", "requestRecipient", "endpoint"],
      "properties": {
        "source": { "const": "hermes-linked-capability" },
        "configurationRequired": { "const": false },
        "requestBotToken": { "const": false },
        "requestRecipient": { "const": false },
        "endpoint": { "const": "v1/telegram/questions" }
      }
    },
    "secretPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collection", "persistValuesInPlugin", "allowedReferences", "neverAskInChat"],
      "properties": {
        "collection": { "const": "host-secure-input" },
        "persistValuesInPlugin": { "const": false },
        "allowedReferences": { "type": "array", "const": ["hermes://", "vault://"] },
        "neverAskInChat": { "const": true }
      }
    },
    "phases": { "type": "array", "minItems": 8, "uniqueItems": true, "items": { "type": "string" } },
    "sourceAuthFlows": {
      "type": "object",
      "additionalProperties": false,
      "required": ["none", "bearer", "basic", "browser_profile"],
      "properties": {
        "none": { "$ref": "#/$defs/authFlow" },
        "bearer": { "$ref": "#/$defs/authFlow" },
        "basic": { "$ref": "#/$defs/authFlow" },
        "browser_profile": { "$ref": "#/$defs/authFlow" }
      }
    },
    "prompts": { "type": "object", "required": ["start", "operator", "source", "terms", "secret", "glassdoor", "schedule"], "additionalProperties": { "type": "string", "minLength": 1 } },
    "readiness": { "type": "object", "required": ["healthPath", "readyPath", "bootstrapPath", "allowPrivateLanHttp", "requireBootstrapWithoutLogin"], "additionalProperties": false, "properties": {
      "healthPath": { "const": "/api/health" },
      "readyPath": { "const": "/api/ready" },
      "bootstrapPath": { "const": "/api/bootstrap" },
      "allowPrivateLanHttp": { "const": true },
      "requireBootstrapWithoutLogin": { "const": true }
    } }
  },
  "$defs": {
    "authFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["securePrompt", "requiresSecretRef", "requiresBrowserProfile"],
      "properties": {
        "securePrompt": { "type": "boolean" },
        "requiresSecretRef": { "type": "boolean" },
        "requiresBrowserProfile": { "type": "boolean" }
      }
    }
  }
}
