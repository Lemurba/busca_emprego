{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://busca-emprego.local/schemas/config.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["projectId", "apiBaseUrl", "maxConcurrency", "maxPerDomain", "batchSize", "timeoutMs", "retry"],
  "properties": {
    "projectId": { "type": "string", "minLength": 1 },
    "apiBaseUrl": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "maxConcurrency": { "type": "integer", "minimum": 1, "maximum": 20, "default": 20 },
    "maxPerDomain": { "type": "integer", "minimum": 1, "maximum": 1, "default": 1 },
    "batchSize": { "type": "integer", "minimum": 1, "maximum": 25, "default": 25 },
    "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 900000 },
    "retry": {
      "type": "object", "additionalProperties": false, "required": ["delaysMs", "jitterRatio"],
      "properties": {
        "delaysMs": { "const": [1000, 5000, 15000] },
        "jitterRatio": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "questionReminderMs": { "type": "integer", "minimum": 60000, "default": 1800000 },
    "integration": {
      "type": "object", "additionalProperties": false,
      "required": ["hermesBaseUrl", "browserHarnessBaseUrl", "serviceTokenSecretRef"],
      "properties": {
        "hermesBaseUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
        "browserHarnessBaseUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
        "serviceTokenSecretRef": { "type": "string", "minLength": 1, "maxLength": 120 },
        "requestTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 900000 },
        "allowInsecureLocalhost": { "type": "boolean", "default": false }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "domain", "enabled", "authStrategy"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,62}$" },
          "domain": { "type": "string", "minLength": 3 },
          "enabled": { "type": "boolean" },
          "authStrategy": { "enum": ["none", "bearer", "basic", "browser_profile"] },
          "secretRefs": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^(hermes|vault)://", "maxLength": 160 } },
          "browserProfileId": { "type": "string", "minLength": 1, "maxLength": 160 }
        }
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "role", "enabled", "promptVersionId", "sourceIds", "allowedDomains", "requestedCapabilities", "concurrency", "timeoutMs"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "maxLength": 500 },
          "role": { "enum": ["coordinator", "source_scout", "job_enrichment", "normalizer_deduper", "match_evaluator", "preference_learner", "resume_writer", "ats_reviewer", "application_assistant"] },
          "enabled": { "type": "boolean" },
          "promptVersionId": { "type": "string", "minLength": 1 },
          "customInstructions": { "type": "string", "maxLength": 12000 },
          "sourceIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "allowedDomains": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)*[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$" } },
          "requestedCapabilities": { "type": "array", "uniqueItems": true, "items": { "enum": ["agent.invoke", "browser.read", "jobs.read", "jobs.write", "jobs.create", "jobs.enrich", "salary.lookup", "resume.read", "resume.write", "preferences.write", "application.prepare", "telegram.question"] } },
          "concurrency": { "type": "integer", "minimum": 1, "maximum": 20 },
          "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 900000 }
        }
      }
    }
  }
}
