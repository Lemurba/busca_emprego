{
  "$schema": "./schemas/manifest.schema.json",
  "id": "busca-emprego",
  "name": "Busca Emprego",
  "version": "0.4.0",
  "description": "Orquestra agentes de busca, enriquecimento, avaliação, currículo e preparação manual de candidatura.",
  "entrypoint": "dist/src/index.js",
  "configSchema": "schemas/config.schema.json",
  "onboarding": {
    "contract": "onboarding.json",
    "guide": "ONBOARDING.md",
    "mode": "interactive",
    "secrets": "host-secure-input"
  },
  "roles": [
    "coordinator", "source_scout", "job_enrichment", "normalizer_deduper", "match_evaluator",
    "preference_learner", "resume_writer", "ats_reviewer", "application_assistant"
  ],
  "integration": {
    "kind": "https-gateway",
    "note": "Adapters concretos usam os gateways HTTPS do Hermes e Browser Harness. Telegram usa a capability já vinculada ao Hermes, sem configuração de bot ou destinatário; credenciais de fontes são resolvidas somente por referências do secret store."
  },
  "security": {
    "httpAuthentication": false,
    "networkScope": "private-lan",
    "secrets": "host-only",
    "automaticApplicationRequiresTelegram": false,
    "humanAuthorizationRequired": true,
    "promptCannotExpandCapabilities": true,
    "browserScoutingAndEnrichmentReadOnly": true,
    "externalApplicationExecution": true,
    "applicationExecutionRequiresAuthorizationEnvelope": true
  },
  "dashboard": {
    "agentConfiguration": true,
    "editableFields": ["name", "description", "enabled", "promptVersionId", "customInstructions", "sourceIds", "allowedDomains", "requestedCapabilities", "concurrency", "timeoutMs"],
    "capabilities": "role-bounded"
  }
}
